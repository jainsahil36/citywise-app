{
  "name": "server-api",
  "version": "1.0.0",
  "description": "CityWise Backend API Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "tunnel": "node tunnel.js",
    "dev:tunnel": "concurrently \"npm run dev\" \"npm run tunnel\"",
