# Environment Variables
NODE_ENV=development
PORT=3000

# Database Configuration
# Option 1: Local MongoDB (Default - requires MongoDB installation)
MONGODB_URI=mongodb://localhost:27017/citywise

# Option 2: MongoDB Atlas (Cloud - Replace with your actual connection string)
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/citywise?retryWrites=true&w=majority

# API Configuration
API_BASE_URL=http://localhost:3000/api

# CORS Settings
CORS_ORIGIN=*

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
